rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() { return request.auth != null; }
    function notAnon() { return signedIn() && request.auth.token.firebase.sign_in_provider != 'anonymous'; }
    function compOf(cid) { return get(/databases/$(database)/documents/competitions/$(cid)).data; }
    function isOwner(cid) { return signedIn() && compOf(cid).ownerUid == request.auth.uid; }

    // One document per competition; the 6-letter join code is the document id.
    match /competitions/{cid} {
      allow read: if true;
      allow create: if notAnon()
        && request.resource.data.ownerUid == request.auth.uid
        && request.resource.data.name is string && request.resource.data.name.size() <= 80
        && request.resource.data.type is string && request.resource.data.type.size() <= 20
        && request.resource.data.prizes is list && request.resource.data.prizes.size() <= 10
        && request.resource.data.open == true;
      allow update: if isOwner(cid)
        && request.resource.data.ownerUid == resource.data.ownerUid
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['prizes', 'open', 'name']);
      allow delete: if isOwner(cid);

      // One document per participant, keyed by their (anonymous) auth uid.
      match /participants/{uid} {
        allow read: if true;
        allow create, update: if signedIn() && request.auth.uid == uid
          && compOf(cid).open == true
          && request.resource.data.name is string && request.resource.data.name.size() >= 1 && request.resource.data.name.size() <= 40
          && request.resource.data.group is string && request.resource.data.group.size() <= 40
          && request.resource.data.totalPts is number && request.resource.data.totalPts >= 0 && request.resource.data.totalPts <= 50000
          && request.resource.data.daysLogged is number && request.resource.data.daysLogged >= 0 && request.resource.data.daysLogged <= 30
          && request.resource.data.avgPct is number && request.resource.data.avgPct >= 0 && request.resource.data.avgPct <= 100
          && request.resource.data.quranPages is number && request.resource.data.quranPages >= 0 && request.resource.data.quranPages <= 1000;
        allow delete: if signedIn() && (request.auth.uid == uid || isOwner(cid));
      }
    }
  }
}
